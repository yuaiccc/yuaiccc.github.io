# Volcengine Ark Coding Plan embedding API key.
# Keep this value server-side; do not expose it to the browser.
#
# Used by:
#   - scripts/build-embeddings.mjs  (build time, calls Ark embeddings API)
#   - app/api/search/route.ts       (runtime, called by the top-bar search box)
ARK_API_KEY=
ARK_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_EMBEDDING_MODEL=doubao-embedding-vision
